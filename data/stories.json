   "checklist": [
    {
     "id": "c1",
     "text": "Pick one place your users already hang out and post there every time you ship something, even small updates.",
     "from": "Open source"
    },
    {
     "id": "c2",
     "text": "Give something away free and charge for the convenient version, the way Postiz is free to self-host and paid to use hosted.",
     "from": "Move 1"
    },
    {
     "id": "c3",
     "text": "Build a plug-in for a tool that's growing fast right now, like AI agents or n8n. It's cheap for one person and puts you where new users are looking.",
     "from": "The turning point"
    },
    {
     "id": "c4",
     "text": "Find your most active users and build for them. Postiz followed the automation crowd instead of competing with Buffer.",
     "from": "Finding the users who stay"
    },
    {
     "id": "c5",
     "text": "Don't pay for SEO on a brand-new site. Write a few useful posts yourself and spend the money elsewhere.",
     "from": "Building"
    },
    {
     "id": "c6",
     "text": "Plan for a long flat stretch. Postiz stayed under $15K a month for about 14 months after going open source. Pace yourself around school.",
     "from": "Open source"
    }
   ],
