{
 "cleanUrls": true,
 "trailingSlash": true,
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    }
   ]
  }
 ],
 "redirects": [
  {
   "source": "/signin",
   "destination": "/welcome/",
   "permanent": true
  },
  {
   "source": "/signin/",
   "destination": "/welcome/",
   "permanent": true
  },
  {
   "source": "/signup",
   "destination": "/welcome/",
   "permanent": true
  },
  {
   "source": "/signup/",
   "destination": "/welcome/",
   "permanent": true
  },
  {
   "source": "/pricing",
   "destination": "/#pricing",
   "permanent": true
  },
  {
   "source": "/pricing/",
   "destination": "/#pricing",
   "permanent": true
  },
  {
   "source": "/how-we-check",
   "destination": "/#sources",
   "permanent": true
  },
  {
   "source": "/how-we-check/",
   "destination": "/#sources",
   "permanent": true
  },
  {
   "source": "/breakdowns/postiz",
   "destination": "/blog/postiz/",
   "permanent": true
  },
  {
   "source": "/breakdowns/postiz/",
   "destination": "/blog/postiz/",
   "permanent": true
  },
  {
   "source": "/breakdowns",
   "destination": "/#stories",
   "permanent": true
  },
  {
   "source": "/breakdowns/",
   "destination": "/#stories",
   "permanent": true
  }
 ]
}